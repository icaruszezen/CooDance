{
  "name": "@coodance/desktop",
  "version": "1.3.1",
  "description": "CooDance Desktop Studio for Windows and macOS",
  "author": "CooDance Contributors",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && electron .",
    "package:win": "electron-builder --config electron-builder.yml --win --publish never",
    "package:mac": "electron-builder --config electron-builder.yml --mac --publish never",
    "package:mac:arm64": "electron-builder --config electron-builder.yml --mac dmg --arm64 --publish never",
    "package:mac:x64": "electron-builder --config electron-builder.yml --mac dmg --x64 --publish never",
    "package:linux": "electron-builder --config electron-builder.yml --linux --publish never"
  },
  "dependencies": {
    "@coodance/core": "*",
    "@coodance/mcp": "*",
    "@coodance/remotion": "*",
    "@coodance/server": "*"
  },
  "devDependencies": {
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12"
  }
}
