{
  "name": "@coodance/mcp",
  "version": "1.3.1",
  "type": "module",
  "description": "CooDance MCP Server (dual-transport stdio + Streamable HTTP) for external AI agents",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "coodance-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stdio": {
      "types": "./dist/stdio.d.ts",
      "default": "./dist/stdio.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-stdio.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:stdio": "node dist/stdio.js"
  },
  "dependencies": {
    "@coodance/core": "*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1"
  }
}
